  const n = args.length;
  if (n === 1) return callInWindow('zE', args[0]);
  if (n === 2) return callInWindow('zE', args[0], args[1]);
  if (n === 3) return callInWindow('zE', args[0], args[1], args[2]);
  if (n === 4) return callInWindow('zE', args[0], args[1], args[2], args[3]);
